# ============================================================
# .env.local — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# Supabase — pegue em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Supabase Service Role (só server-side, nunca expor no front)
# Pegue em: Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# URL da aplicação (para QR dinâmico)
# Em dev: http://localhost:3000
# Em prod: https://seudominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
